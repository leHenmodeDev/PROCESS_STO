        "print(f"  Nombre moyen de points: λ * surface = {lambda_2d * area}")\n",
        "\n",
        "# Méthode de simulation:\n",
        "# 1. Simuler N ~ Poisson(λ * surface)\n",
        "# 2. Simuler N points uniformément dans le carré\n",
        "\n",
        "def simuler_processus_ponctuel(lambda_val, x_min, x_max, y_min, y_max):\n",
        "    '''Simule un processus ponctuel de Poisson dans un rectangle'''\n",
        "    area = (x_max - x_min) * (y_max - y_min)\n",
        "    N = np.random.poisson(lambda_val * area)\n",
        "    \n",
        "    # Simuler N points uniformes\n",
        "    x_coords = np.random.uniform(x_min, x_max, N)\n",
        "    y_coords = np.random.uniform(y_min, y_max, N)\n",
        "    \n",
        "    return x_coords, y_coords, N\n",
        "\n",
        "# Simulation\n",
        "np.random.seed(42)\n",
        "x_points, y_points, N_points = simuler_processus_ponctuel(lambda_2d, x_min, x_max, y_min, y_max)\n",
        "\n",
