        "## 2. Estimation empirique de la fonction d'intensité λ(t)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "trusted": true
      },
      "outputs": [],
      "source": [
        "# Méthode: Estimation par noyau (kernel density estimation)\n",
        "# On simule plusieurs trajectoires et on estime λ(t) = E[dN(t)]/dt\n",
        "\n",
        "n_trajectories = 1000\n",
        "T_est = 20\n",
        "\n",
        "# Simuler plusieurs trajectoires\n",
        "all_sauts = []\n",
        "\n",
        "for _ in range(n_trajectories):\n",
        "    sauts = simuler_poisson_non_homogene(lambda_t, T_est, lambda_max=lambda_max_est)\n",
        "    all_sauts.append(sauts)\n",
        "\n",
        "# Méthode 1: Estimation par histogramme des sauts\n",
        "# On divise [0, T] en petits intervalles et on compte les sauts\n",
        "n_bins = 100\n",
        "bin_edges = np.linspace(0, T_est, n_bins + 1)\n",
        "bin_centers = (bin_edges[:-1] + bin_edges[1:]) / 2\n",
        "bin_width = bin_edges[1] - bin_edges[0]\n",
        "\n",
        "# Compter les sauts dans chaque bin pour toutes les trajectoires\n",
        "bin_counts = np.zeros(n_bins)\n",
        "\n",
        "for sauts in all_sauts:\n",
        "    for s in sauts:\n",
        "        bin_idx = np.searchsorted(bin_edges, s) - 1\n",
        "        if 0 <= bin_idx < n_bins:\n",
        "            bin_counts[bin_idx] += 1\n",
        "\n",
        "# Estimation de λ(t): nombre moyen de sauts par unité de temps\n",
        "lambda_hat_hist = bin_counts / (n_trajectories * bin_width)\n",
        "\n",
        "# Méthode 2: Estimation par noyau (plus lisse)\n",
        "from scipy.stats import gaussian_kde\n",
        "\n",
        "# Collecter tous les sauts\n",
        "all_sauts_flat = np.concatenate(all_sauts)\n",
        "\n",
        "if len(all_sauts_flat) > 1:\n",
        "    # Estimation par noyau de la densité des sauts\n",
        "    kde = gaussian_kde(all_sauts_flat, bw_method='scott')\n",
        "    \n",
        "    # Évaluer sur une grille\n",
        "    t_kde = np.linspace(0, T_est, 200)\n",
        "    density_kde = kde(t_kde)\n",
        "    \n",
        "    # Normaliser pour obtenir λ(t) (la densité intégrée doit donner le nombre total de sauts)\n",
        "    # λ(t) ≈ density_kde(t) * n_trajectories\n",
        "    lambda_hat_kde = density_kde * n_trajectories\n",
        "\n",
        "# Visualisation\n",
        "plt.figure(figsize=(15, 8))\n",
        "\n",
        "# Tracer la vraie fonction d'intensité\n",
        "plt.plot(t_plot, lambda_plot, 'k-', linewidth=2, label='λ(t) vrai = 2 + sin(t)')\n",
        "\n",
        "# Tracer l'estimation par histogramme\n",
        "plt.plot(bin_centers, lambda_hat_hist, 'b-', linewidth=1.5, alpha=0.7, label='Estimation histogramme')\n",
        "\n",
        "# Tracer l'estimation par noyau\n",
        "if len(all_sauts_flat) > 1:\n",
        "    plt.plot(t_kde, lambda_hat_kde, 'r-', linewidth=1.5, alpha=0.7, label='Estimation noyau')\n",
        "\n",
        "plt.xlabel('Temps t', fontsize=14)\n",
        "plt.ylabel('λ(t)', fontsize=14)\n",
        "plt.title('Estimation empirique de la fonction d\'intensité λ(t)', \n",
        "          fontsize=16, fontweight='bold')\n",
        "plt.legend(fontsize=12)\n",
        "plt.grid(True, alpha=0.3)\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# Calcul de l'erreur quadratique moyenne\n",
        "lambda_true_at_centers = lambda_t(bin_centers)\n",
        "mse_hist = np.mean((lambda_hat_hist - lambda_true_at_centers)**2)\n",
        "\n",
        "print(f"Erreur quadratique moyenne (histogramme): {mse_hist:.6f}")\n",
        "\n",
        "if len(all_sauts_flat) > 1:\n",
        "    lambda_true_at_kde = lambda_t(t_kde)\n",
        "    mse_kde = np.mean((lambda_hat_kde - lambda_true_at_kde)**2)\n",
        "    print(f"Erreur quadratique moyenne (noyau): {mse_kde:.6f}")\n",
        "\n",
        "print("\n✓ Méthode d'estimation de λ(t) implémentée avec succès!")"
      ]
    },
