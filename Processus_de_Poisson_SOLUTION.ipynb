      "source": [
        "# Processus de Poisson - Solutions Complètes\n",
        "## Solutions pour tous les exercices du notebook Processus de Poisson"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "trusted": true
      },
      "outputs": [],
      "source": [
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from scipy import stats\n",
        "import pandas as pd\n",
        "import seaborn as sns\n",
        "\n",
        "# Configuration des graphiques\n",
        "plt.style.use('seaborn')\n",
        "np.random.seed(42)  # Pour la reproductibilité\n",
        "\n",
        "# Fonction de base pour simuler un processus de Poisson\n",
        "def simuler_poisson(lmbda, T):\n",
        "    '''Simule un processus de Poisson homogène d'intensité lambda sur [0, T]'''\n",
        "    t = 0\n",
        "    sauts = []\n",
        "    while t < T:\n",
        "        t += np.random.exponential(1/lmbda)\n",
        "        if t < T:\n",
        "            sauts.append(t)\n",
        "    return np.array(sauts)"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# Exercice 1: Estimation\n",
        "## 1. Génération d'une trajectoire et estimation de λ"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "trusted": true
      },
      "outputs": [],
      "source": [
        "# Paramètres\n",
        "lambda_true = 2  # Intensité réelle\n",
        "T = 1000  # Longueur de la trajectoire\n",
        "\n",
        "# Simulation d'une trajectoire\n",
        "np.random.seed(42)\n",
        "sauts = simuler_poisson(lambda_true, T)\n",
        "N = len(sauts)\n",
        "\n",
        "print(f"Paramètres:")\n",
        "print(f"  λ vrai = {lambda_true}")\n",
        "print(f"  T = {T}")\n",
        "print(f"  Nombre de sauts observés: {N}")\n",
        "print(f"  Dernier saut: {sauts[-1] if N > 0 else 0:.4f}")\n",
        "\n",
        "# Estimateur de λ: λ̂ = N / T\n",
        "lambda_hat = N / T\n",
        "print(f"\nEstimation de λ: λ̂ = {lambda_hat:.6f}")\n",
        "print(f"Erreur relative: {abs(lambda_hat - lambda_true) / lambda_true * 100:.2f}%")\n",
        "\n",
        "# Visualisation de la trajectoire\n",
        "plt.figure(figsize=(15, 6))\n",
        "\n",
        "# Trajectoire N(t) - processus de comptage\n",
        "times = np.concatenate([[0], sauts])\n",
        "values = np.arange(N + 1)\n",
        "\n",
        "plt.step(times, values, where='post', color='steelblue', linewidth=1.5)\n",
        "plt.xlabel('Temps t', fontsize=14)\n",
        "plt.ylabel('N(t)', fontsize=14)\n",
        "plt.title(f'Trajectoire d\'un processus de Poisson (λ={lambda_true}, T={T})', \n",
        "          fontsize=16, fontweight='bold')\n",
        "plt.grid(True, alpha=0.3)\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 2. Propriétés de l'estimateur λ̂ = N/T"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "trusted": true
      },
      "outputs": [],
      "source": [
        "# Propriétés théoriques:\n",
        "# - λ̂ = N/T est un estimateur sans biais: E[λ̂] = λ\n",
        "# - Variance: Var(λ̂) = λ/T\n",
        "# - Convergence: λ̂ -> λ presque sûrement quand T -> ∞\n",
        "# - Normalité asymptotique: sqrt(T)(λ̂ - λ) -> N(0, sqrt(λ)) en loi\n",
        "\n",
        "print("Propriétés théoriques de λ̂ = N/T:")\n",
        "print("  1. Sans biais: E[λ̂] = λ")\n",
        "print("  2. Variance: Var(λ̂) = λ/T")\n",
        "print("  3. Consistant: λ̂ -> λ p.s. quand T -> ∞")\n",
        "print("  4. Normalité asymptotique: √T(λ̂ - λ) -> N(0, √λ) en loi")\n",
        "\n",
        "# Vérification empirique des propriétés\n",
        "n_simulations = 1000  # Nombre de trajectoires\n",
        "T_values = [10, 100, 1000, 10000]  # Différentes valeurs de T\n",
        "\n",
        "results = []\n",
        "\n",
        "for T_val in T_values:\n",
        "    lambda_hats = []\n",
        "    \n",
        "    for _ in range(n_simulations):\n",
        "        sauts = simuler_poisson(lambda_true, T_val)\n",
        "        N_val = len(sauts)\n",
        "        lambda_hats.append(N_val / T_val)\n",
        "    \n",
        "    lambda_hats = np.array(lambda_hats)\n",
        "    mean_lambda_hat = np.mean(lambda_hats)\n",
        "    std_lambda_hat = np.std(lambda_hats)\n",
        "    var_lambda_hat = np.var(lambda_hats)\n",
        "    theoretical_var = lambda_true / T_val\n",
        "    \n",
        "    results.append({\n",
        "        'T': T_val,\n",
        "        'mean': mean_lambda_hat,\n",
        "        'std': std_lambda_hat,\n",
        "        'var_emp': var_lambda_hat,\n",
        "        'var_theo': theoretical_var,\n",
        "        'bias': abs(mean_lambda_hat - lambda_true)\n",
        "    })\n",
        "\n",
        "# Affichage des résultats\n",
        "print("\nVérification empirique pour différentes valeurs de T:")\n",
        "print("-" * 80)\n",
        "print(f"{'T':<8} {'Moyenne':<12} {'Écart-type':<15} {'Var_emp':<15} {'Var_théo':<15} {'Biais':<12}")\n",
        "print("-" * 80)\n",
        "for res in results:\n",
        "    print(f'{res[\"T\"]:<8} {res[\"mean\"]:<12.6f} {res[\"std\"]:<15.6f} {res[\"var_emp\"]:<15.6f} {res[\"var_theo\"]:<15.6f} {res[\"bias\"]:<12.6f}')\n",
        "\n",
        "# Visualisation de la convergence\n",
        "plt.figure(figsize=(15, 6))\n",
        "\n",
        "# Tracer les moyennes\n",
        "T_array = np.array([r['T'] for r in results])\n",
        "mean_array = np.array([r['mean'] for r in results])\n",
        "std_array = np.array([r['std'] for r in results])\n",
        "\n",
        "plt.subplot(1, 2, 1)\n",
        "plt.plot(T_array, mean_array, 'o-', color='steelblue', linewidth=2, markersize=8)\n",
        "plt.axhline(y=lambda_true, color='red', linestyle='--', linewidth=2, label='λ vrai')\n",
        "plt.xlabel('T', fontsize=12)\n",
        "plt.ylabel('E[λ̂]', fontsize=12)\n",
        "plt.title('Moyenne de λ̂ en fonction de T', fontweight='bold')\n",
        "plt.legend()\n",
        "plt.grid(True, alpha=0.3)\n",
        "\n",
        "# Tracer les écarts-types\n",
        "plt.subplot(1, 2, 2)\n",
        "plt.plot(T_array, std_array, 's-', color='coral', linewidth=2, markersize=8)\n",
        "theoretical_std = np.sqrt(lambda_true / T_array)\n",
        "plt.plot(T_array, theoretical_std, 'r--', linewidth=2, label='Écart-type théorique')\n",
        "plt.xlabel('T', fontsize=12)\n",
        "plt.ylabel('σ(λ̂)', fontsize=12)\n",
        "plt.title('Écart-type de λ̂ en fonction de T', fontweight='bold')\n",
        "plt.legend()\n",
        "plt.grid(True, alpha=0.3)\n",
        "\n",
        "plt.suptitle('Vérification des propriétés de l\'estimateur λ̂ = N/T', \n",
        "                 fontsize=16, fontweight='bold', y=1.05)\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "trusted": true
      },
      "outputs": [],
      "source": [
        "# Vérification de la normalité asymptotique\n",
        "T_large = 10000\n",
        "n_sim_large = 5000\n",
        "\n",
        "lambda_hats_large = []\n",
        "for _ in range(n_sim_large):\n",
        "    sauts = simuler_poisson(lambda_true, T_large)\n",
        "    N_val = len(sauts)\n",
        "    lambda_hats_large.append(N_val / T_large)\n",
        "\n",
        "lambda_hats_large = np.array(lambda_hats_large)\n",
        "\n",
        "# Standardisation: Z = sqrt(T) * (λ̂ - λ)\n",
        "Z = np.sqrt(T_large) * (lambda_hats_large - lambda_true)\n",
        "\n",
        "# Test de normalité avec QQ-Plot\n",
        "plt.figure(figsize=(15, 6))\n",
        "\n",
        "# Histogramme de Z\n",
        "plt.subplot(1, 2, 1)\n",
        "plt.hist(Z, bins=50, density=True, color='steelblue', alpha=0.7, label='Z empirique')\n",
        "x = np.linspace(-5, 5, 100)\n",
        "pdf_normal = stats.norm.pdf(x, loc=0, scale=np.sqrt(lambda_true))\n",
        "plt.plot(x, pdf_normal, 'r-', linewidth=2, label='N(0, √λ)')\n",
        "plt.xlabel('Z', fontsize=12)\n",
        "plt.ylabel('Densité', fontsize=12)\n",
        "plt.title('Distribution de Z = √T(λ̂ - λ)', fontweight='bold')\n",
        "plt.legend()\n",
        "plt.grid(True, alpha=0.3)\n",
        "\n",
        "# QQ-Plot\n",
        "plt.subplot(1, 2, 2)\n",
        "stats.probplot(Z, dist='norm', sparams=(0, np.sqrt(lambda_true)), plot=plt)\n",
        "plt.title('QQ-Plot pour Z', fontweight='bold')\n",
        "plt.grid(True, alpha=0.3)\n",
        "\n",
        "plt.suptitle('Vérification de la normalité asymptotique', \n",
        "                 fontsize=16, fontweight='bold', y=1.05)\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# Test de Shapiro-Wilk pour la normalité\n",
        "shapiro_stat, shapiro_pvalue = stats.shapiro(Z)\n",
        "print(f"Test de Shapiro-Wilk pour Z: statistique = {shapiro_stat:.6f}, p-value = {shapiro_pvalue:.6f}")\n",
        "\n",
        "if shapiro_pvalue > 0.05:\n",
        "    print("✓ La normalité asymptotique est validée empiriquement!")\n",
        "else:\n",
        "    print("⚠ La normalité n'est pas parfaitement validée, mais cela peut être dû à la taille d'échantillon.")"
      ]
    },
    {
