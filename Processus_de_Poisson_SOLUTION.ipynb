      "metadata": {
        "trusted": true
      },
      "outputs": [],
      "source": [
        "# Fonction d'intensité non-homogène\n",
        "def lambda_t(t):\n",
        "    return 2 + np.sin(t)\n",
        "\n",
        "# Méthode de simulation: Algorithme de Lewis-Shedler\n",
        "# On utilise le fait que si Λ(t) = ∫₀ᵗ λ(s)ds, alors Λ⁻¹ est une fonction croissante\n",
        "# et N(t) = max{n: Λ⁻¹(Γₙ) ≤ t} où Γₙ sont les temps d'un Poisson homogène de rate 1\n",
        "\n",
        "def simuler_poisson_non_homogene(lambda_func, T, lambda_max=None):\n",
        "    '''Simule un processus de Poisson non-homogène avec intensité lambda_func(t)'''\n",
        "    \n",
        "    # Si lambda_max n'est pas fourni, l'estimer\n",
        "    if lambda_max is None:\n",
        "        # Estimer le maximum de lambda sur [0, T]\n",
        "        t_test = np.linspace(0, T, 1000)\n",
        "        lambda_max = max(lambda_func(t_test))\n",
        "    \n",
        "    # Méthode de l'acceptation-rejet\n",
        "    sauts = []\n",
        "    t = 0\n",
        "    \n",
        "    while t < T:\n",
        "        # Générer un candidat selon Poisson homogène de rate lambda_max\n",
        "        t_candidate = t + np.random.exponential(1/lambda_max)\n",
        "        \n",
        "        if t_candidate >= T:\n",
        "            break\n",
        "        \n",
        "        # Accepter avec probabilité lambda(t_candidate) / lambda_max\n",
        "        u = np.random.random()\n",
        "        if u <= lambda_func(t_candidate) / lambda_max:\n",
        "            sauts.append(t_candidate)\n",
        "            t = t_candidate\n",
        "        else:\n",
        "            t = t_candidate  # On rejette mais on avance le temps\n",
        "    \n",
        "    return np.array(sauts)\n",
        "\n",
        "# Test de la simulation\n",
        "T_non_hom = 20\n",
        "np.random.seed(42)\n",
        "\n",
        "# Estimer lambda_max pour notre fonction\n",
        "lambda_max_est = 2 + 1  # max(2 + sin(t)) = 3\n",
        "\n",
        "sauts_non_hom = simuler_poisson_non_homogene(lambda_t, T_non_hom, lambda_max=lambda_max_est)\n",
        "\n",
        "print(f"Simulation d'un processus de Poisson non-homogène (λ(t) = 2 + sin(t)):")\n",
        "print(f"  T = {T_non_hom}")\n",
        "print(f"  λ_max estimé = {lambda_max_est}")\n",
        "print(f"  Nombre de sauts: {len(sauts_non_hom)}")\n",
        "print(f"  Temps des sauts: {sauts_non_hom[:10]}")\n",
        "\n",
        "# Visualisation\n",
        "plt.figure(figsize=(15, 6))\n",
        "\n",
        "# Tracer la fonction d'intensité\n",
        "t_plot = np.linspace(0, T_non_hom, 500)\n",
        "lambda_plot = lambda_t(t_plot)\n",
        "\n",
        "plt.plot(t_plot, lambda_plot, 'r-', linewidth=2, label='λ(t) = 2 + sin(t)')\n",
        "\n",
        "# Tracer les sauts\n",
        "if len(sauts_non_hom) > 0:\n",
        "    plt.stem(sauts_non_hom, np.ones(len(sauts_non_hom)) * max(lambda_plot) * 1.1, \n",
        "             linefmt='steelblue-', markerfmt='bo', basefmt=' ', label='Sauts')\n",
        "\n",
        "plt.xlabel('Temps t', fontsize=14)\n",
        "plt.ylabel('Intensité / Sauts', fontsize=14)\n",
        "plt.title('Processus de Poisson non-homogène avec λ(t) = 2 + sin(t)', \n",
        "          fontsize=16, fontweight='bold')\n",
        "plt.legend(fontsize=12)\n",
        "plt.grid(True, alpha=0.3)\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# Vérification: le nombre moyen de sauts devrait être ∫₀^T λ(t)dt\n",
        "integral_lambda = lambda_max_est * T_non_hom  # Approximation par lambda_max * T\n",
        "# Plus précisément:\n",
        "integral_lambda_exact = 2 * T_non_hom + (np.cos(0) - np.cos(T_non_hom))\n",
        "print(f"\nNombre théorique moyen de sauts: ∫₀^{T_non_hom} λ(t)dt = {integral_lambda_exact:.4f}")\n",
        "print(f"Nombre empirique de sauts: {len(sauts_non_hom)}")"
      ]
    },
