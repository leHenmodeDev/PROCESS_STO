      "source": [
        "## 2. Estimation de P(contrôles non terminés à 18h)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "trusted": true
      },
      "outputs": [],
      "source": [
        "# Simulation Monte-Carlo\n",
        "n_mc_days = 10000\n",
        "target_time = 18 * 3600  # 18h en secondes\n",
        "\n",
        "not_finished_count = 0\n",
        "\n",
        "for _ in range(n_mc_days):\n",
        "    arrivals, start_times, end_times = simuler_journee(\n",
        "        arrival_rate, service_min, service_max, n_guichets, operation_duration\n",
        "    )\n",
        "    \n",
        "    # Vérifier si tous les contrôles sont terminés à 18h\n",
        "    if end_times.max() > target_time:\n",
        "        not_finished_count += 1\n",
        "\n",
        "p_not_finished = not_finished_count / n_mc_days\n",
        "\n",
        "print(f"Estimation Monte-Carlo:")\n",
        "print(f"  Nombre de simulations: {n_mc_days}")\n",
        "print(f"  Nombre de jours avec contrôles non terminés à 18h: {not_finished_count}")\n",
        "print(f"  P(contrôles non terminés à 18h) = {p_not_finished:.6f} ({p_not_finished*100:.2f}%)")\n",
        "\n",
        "# Intervalle de confiance à 95%\n",
        "std_error = np.sqrt(p_not_finished * (1 - p_not_finished) / n_mc_days)\n",
        "ci_lower = p_not_finished - 1.96 * std_error\n",
        "ci_upper = p_not_finished + 1.96 * std_error\n",
        "\n",
        "print(f"\nIntervalle de confiance à 95%: [{ci_lower:.6f}, {ci_upper:.6f}]")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 3. Détermination de l'heure d'ouverture du 3ème guichet"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "trusted": true
      },
      "outputs": [],
      "source": [
        "# On veut trouver l'heure t_0 telle que si on ouvre un 3ème guichet à t_0,\n",
        "# alors P(contrôles terminés à 18h) > 90%\n",
        "# C'est-à-dire P(contrôles non terminés à 18h) < 10%\n",
        "\n",
        "# Fonction pour simuler avec 3 guichets ouverts à partir de t_0\n",
        "def simuler_journee_3guichets(arrival_rate, service_min, service_max, t_0, duration):\n",
        "    '''Simule avec 2 guichets jusqu'à t_0, puis 3 guichets après'''\n",
        "    \n",
        "    # 1. Simuler les arrivées\n",
        "    arrivals = simuler_poisson(arrival_rate, duration)\n",
        "    arrivals += opening_time\n",
        "    \n",
        "    # 2. Simuler les temps de service\n",
        "    service_times = np.random.uniform(service_min, service_max, len(arrivals))\n",
        "    \n",
        "    # 3. Simuler le processus de service\n",
        "    # 2 guichets jusqu'à t_0, puis 3 guichets\n",
        "    guichet_end_times = np.zeros(3)  # 3 guichets, mais le 3ème n'est pas actif avant t_0\n",
        "    guichet_end_times[2] = t_0  # Le 3ème guichet n'est disponible qu'à partir de t_0\n",
        "    \n",
        "    start_times = np.zeros(len(arrivals))\n",
        "    end_times = np.zeros(len(arrivals))\n",
        "    \n",
        "    for i, (arrival, service_time) in enumerate(zip(arrivals, service_times)):\n",
        "        # Trouver le guichet disponible le plus tôt\n",
        "        available_guichet = np.argmin(guichet_end_times)\n",
        "        \n",
        "        start_time = max(arrival, guichet_end_times[available_guichet])\n",
        "        end_time = start_time + service_time\n",
        "        \n",
        "        start_times[i] = start_time\n",
        "        end_times[i] = end_time\n",
        "        guichet_end_times[available_guichet] = end_time\n",
        "    \n",
        "    return arrivals, start_times, end_times\n",
        "\n",
        "# Recherche de t_0 par dichotomie\n",
        "# On cherche t_0 dans [8h, 17h]\n",
        "t_min = opening_time  # 8h\n",
        "t_max = closing_time  # 17h\n",
        "target_prob = 0.1  # On veut P(non terminé) < 10%\n",
        "\n",
        "def estimate_p_not_finished(t_0, n_sim=1000):\n",
        "    '''Estime P(contrôles non terminés à 18h) avec ouverture du 3ème guichet à t_0'''\n",
        "    not_finished = 0\n",
        "    \n",
        "    for _ in range(n_sim):\n",
        "        arrivals, start_times, end_times = simuler_journee_3guichets(\n",
        "            arrival_rate, service_min, service_max, t_0, operation_duration\n",
        "        )\n",
        "        if end_times.max() > target_time:\n",
        "            not_finished += 1\n",
        "    \n",
        "    return not_finished / n_sim\n",
        "\n",
        "# Recherche dichotomique\n",
        "n_iterations = 20\n",
        "n_sim_per_iter = 500  # Pour accélérer\n",
        "\n",
        "for iteration in range(n_iterations):\n",
        "    t_mid = (t_min + t_max) / 2\n",
        "    p_mid = estimate_p_not_finished(t_mid, n_sim=n_sim_per_iter)\n",
        "    \n",
        "    if p_mid < target_prob:\n",
        "        t_max = t_mid  # On peut essayer plus tard\n",
        "    else:\n",
        "        t_min = t_mid  # Il faut ouvrir plus tôt\n",
        "    \n",
        "    print(f"Itération {iteration+1}: t_0 = {t_mid/3600:.2f}h, P(non terminé) = {p_mid:.4f}")\n",
        "\n",
        "# Estimation finale avec plus de précision\n",
        "t_0_final = (t_min + t_max) / 2\n",
        "p_final = estimate_p_not_finished(t_0_final, n_sim=5000)\n",
        "\n",
        "print(f"\n" + "="*60)\n",
        "print(f"RESULTAT FINAL:")\n",
        "print(f"  Heure d'ouverture optimale du 3ème guichet: {t_0_final/3600:.2f}h")\n",
        "print(f"  P(contrôles non terminés à 18h) = {p_final:.4f} ({p_final*100:.2f}%)")\n",
        "\n",
        "if p_final < target_prob:\n",
        "    print("  ✓ La probabilité est bien inférieure à 10%")\n",
        "else:\n",
        "    print("  ⚠ La probabilité est légèrement supérieure à 10%")\n",
        "\n",
        "# Visualisation de la relation entre t_0 et P(non terminé)\n",
        "t_0_test_values = np.linspace(opening_time, closing_time, 10)\n",
        "p_values = []\n",
        "\n",
        "for t_0 in t_0_test_values:\n",
        "    p = estimate_p_not_finished(t_0, n_sim=500)\n",
        "    p_values.append(p)\n",
        "\n",
        "plt.figure(figsize=(15, 6))\n",
        "plt.plot(t_0_test_values/3600, p_values, 'o-', color='steelblue', linewidth=2, markersize=8)\n",
        "plt.axhline(y=0.1, color='red', linestyle='--', linewidth=2, label='Seuil 10%')\n",
        "plt.axvline(x=t_0_final/3600, color='green', linestyle=':', linewidth=2, label=f't_0 optimal = {t_0_final/3600:.2f}h')\n",
        "plt.xlabel('Heure d\'ouverture du 3ème guichet', fontsize=14)\n",
        "plt.ylabel('P(contrôles non terminés à 18h)', fontsize=14)\n",
        "plt.title('Relation entre l\'heure d\'ouverture du 3ème guichet et la probabilité de retard', \n",
        "          fontsize=16, fontweight='bold')\n",
        "plt.legend(fontsize=12)\n",
        "plt.grid(True, alpha=0.3)\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ]
