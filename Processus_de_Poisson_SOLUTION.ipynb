      "source": [
        "# Exercice 2: Processus de Poisson marqués\n",
        "## Simulation avec λ_A = 2 et λ_B = 5"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "trusted": true
      },
      "outputs": [],
      "source": [
        "# Paramètres\n",
        "lambda_A = 2\n",
        "lambda_B = 5\n",
        "lambda_total = lambda_A + lambda_B\n",
        "T_markov = 1000\n",
        "\n",
        "# Probabilités théoriques\n",
        "# P(A) = λ_A / (λ_A + λ_B)\n",
        "# P(B) = λ_B / (λ_A + λ_B)\n",
        "p_A_theo = lambda_A / lambda_total\n",
        "p_B_theo = lambda_B / lambda_total\n",
        "\n",
        "print("Paramètres:")\n",
        "print(f"  λ_A = {lambda_A}, λ_B = {lambda_B}")\n",
        "print(f"  λ_total = {lambda_total}")\n",
        "print(f"\nProbabilités théoriques:")\n",
        "print(f"  P(A) = {p_A_theo:.4f}")\n",
        "print(f"  P(B) = {p_B_theo:.4f}")\n",
        "\n",
        "# Fonction pour simuler un processus de Poisson marqué\n",
        "def simuler_poisson_marque(lambda_A, lambda_B, T):\n",
        "    '''Simule un processus de Poisson marqué avec deux types A et B'''\n",
        "    # Simuler les temps de saut du processus total\n",
        "    sauts_total = simuler_poisson(lambda_total, T)\n",
        "    \n",
        "    # Attribuer un type à chaque saut\n",
        "    types = []\n",
        "    for _ in sauts_total:\n",
        "        # Générer un type selon les probabilités\n",
        "        if np.random.random() < p_A_theo:\n",
        "            types.append('A')\n",
        "        else:\n",
        "            types.append('B')\n",
        "    \n",
        "    return sauts_total, np.array(types)\n",
        "\n",
        "# Simulation\n",
        "np.random.seed(42)\n",
        "sauts_marque, types_marque = simuler_poisson_marque(lambda_A, lambda_B, T_markov)\n",
        "\n",
        "print(f"\nSimulation:")\n",
        "print(f"  Nombre total de sauts: {len(sauts_marque)}")\n",
        "print(f"  Nombre de sauts A: {np.sum(types_marque == 'A')}")\n",
        "print(f"  Nombre de sauts B: {np.sum(types_marque == 'B')}")\n",
        "\n",
        "# Visualisation\n",
        "plt.figure(figsize=(15, 6))\n",
        "\n",
        "# Tracer les sauts de type A\n",
        "sauts_A = sauts_marque[types_marque == 'A']\n",
        "sauts_B = sauts_marque[types_marque == 'B']\n",
        "\n",
        "plt.stem(sauts_A, np.ones(len(sauts_A)), \n",
        "         linefmt='steelblue-', markerfmt='bo', basefmt=' ', label='Type A')\n",
        "plt.stem(sauts_B, np.ones(len(sauts_B)) * 2, \n",
        "         linefmt='coral-', markerfmt='rs', basefmt=' ', label='Type B')\n",
        "\n",
        "plt.xlabel('Temps t', fontsize=14)\n",
        "plt.ylabel('Type', fontsize=14)\n",
        "plt.title('Trajectoire d\'un processus de Poisson marqué (λ_A=2, λ_B=5)', \n",
        "          fontsize=16, fontweight='bold')\n",
        "plt.yticks([1, 2], ['A', 'B'])\n",
        "plt.ylim(0, 3)\n",
        "plt.legend(fontsize=12)\n",
        "plt.grid(True, alpha=0.3, axis='x')\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "trusted": true
      },
      "outputs": [],
      "source": [
        "# Estimation par Monte-Carlo des probabilités\n",
        "n_mc_simulations = 10000\n",
        "\n",
        "# Question 2: Probabilité que le premier saut soit de type A\n",
        "# Théorique: P(premier saut = A) = λ_A / (λ_A + λ_B) = p_A_theo\n",
        "\n",
        "first_jump_A_count = 0\n",
        "\n",
        "for _ in range(n_mc_simulations):\n",
        "    sauts, types = simuler_poisson_marque(lambda_A, lambda_B, T_markov)\n",
        "    if len(sauts) > 0:\n",
        "        if types[0] == 'A':\n",
        "            first_jump_A_count += 1\n",
        "\n",
        "p_first_A_mc = first_jump_A_count / n_mc_simulations\n",
        "print(f"Probabilité que le premier saut soit A:")\n",
        "print(f"  Théorique: {p_A_theo:.6f}")\n",
        "print(f"  Monte-Carlo: {p_first_A_mc:.6f}")\n",
        "print(f"  Erreur: {abs(p_first_A_mc - p_A_theo):.6f}")\n",
        "\n",
        "# Question 3: Probabilité qu'il y ait au moins un saut de type A dans [0,1]\n",
        "# Théorique: P(N_A([0,1]) >= 1) = 1 - P(N_A([0,1]) = 0) = 1 - exp(-λ_A * 1)\n",
        "p_at_least_one_A_theo = 1 - np.exp(-lambda_A * 1)\n",
        "\n",
        "at_least_one_A_count = 0\n",
        "\n",
        "for _ in range(n_mc_simulations):\n",
        "    sauts, types = simuler_poisson_marque(lambda_A, lambda_B, 1)  # [0,1]\n",
        "    if len(sauts) > 0 and 'A' in types:\n",
        "        at_least_one_A_count += 1\n",
        "\n",
        "p_at_least_one_A_mc = at_least_one_A_count / n_mc_simulations\n",
        "print(f"\nProbabilité d'au moins un saut A dans [0,1]:")\n",
        "print(f"  Théorique: {p_at_least_one_A_theo:.6f}")\n",
        "print(f"  Monte-Carlo: {p_at_least_one_A_mc:.6f}")\n",
        "print(f"  Erreur: {abs(p_at_least_one_A_mc - p_at_least_one_A_theo):.6f}")\n",
        "\n",
        "# Question 4: Probabilité que le nombre de sauts de type A soit supérieur à celui de type B dans [0,1]\n",
        "# On simule sur [0,1] et on compare les comptes\n",
        "\n",
        "A_gt_B_count = 0\n",
        "\n",
        "for _ in range(n_mc_simulations):\n",
        "    sauts, types = simuler_poisson_marque(lambda_A, lambda_B, 1)\n",
        "    n_A = np.sum(types == 'A')\n",
        "    n_B = np.sum(types == 'B')\n",
        "    if n_A > n_B:\n",
        "        A_gt_B_count += 1\n",
        "\n",
        "p_A_gt_B_mc = A_gt_B_count / n_mc_simulations\n",
        "\n",
        "# Calcul théorique (approximation par Poisson indépendants)\n",
        "# N_A ~ Poisson(λ_A), N_B ~ Poisson(λ_B), indépendants\n",
        "# P(N_A > N_B) = Σ_{k=0}^∞ P(N_A > k) * P(N_B = k)\n",
        "\n",
        "max_k = 20  # Suffisant car λ_B = 5\n",
        "p_A_gt_B_theo = 0\n",
        "for k in range(max_k):\n",
        "    p_N_B_k = stats.poisson.pmf(k, lambda_B * 1)\n",
        "    p_N_A_gt_k = 1 - stats.poisson.cdf(k, lambda_A * 1)\n",
        "    p_A_gt_B_theo += p_N_A_gt_k * p_N_B_k\n",
        "\n",
        "print(f"\nProbabilité que N_A > N_B dans [0,1]:")\n",
        "print(f"  Théorique: {p_A_gt_B_theo:.6f}")\n",
