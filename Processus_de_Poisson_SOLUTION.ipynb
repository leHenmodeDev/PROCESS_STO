        "print(f"  Nombre de points générés: {N_points}")\n",
        "print(f"  Coordonnées (premiers 10):")\n",
        "for i in range(min(10, N_points)):\n",
        "    print(f"    Point {i+1}: ({x_points[i]:.2f}, {y_points[i]:.2f})")\n",
        "\n",
        "# Visualisation\n",
        "plt.figure(figsize=(12, 12))\n",
        "\n",
        "# Tracer les points\n",
        "plt.scatter(x_points, y_points, s=10, color='steelblue', alpha=0.6)\n",
        "\n",
