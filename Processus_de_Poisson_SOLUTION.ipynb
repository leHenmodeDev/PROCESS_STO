      "source": [
        "## 3. Méthode empirique pour estimer la loi du k-ème temps de saut (k=5)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "trusted": true
      },
      "outputs": [],
      "source": [
        "# Pour un processus de Poisson d'intensité λ=1, le k-ème temps de saut S_k\n",
        "# suit une loi Gamma(k, 1/λ) = Gamma(k, 1) car λ=1\n",
        "\n",
        "lambda_k = 1\n",
        "k = 5\n",
        "n_sim_k = 10000  # Nombre de simulations\n",
        "\n",
        "# Simulation des k-èmes temps de saut\n",
        "S_k_values = []\n",
        "\n",
        "for _ in range(n_sim_k):\n",
        "    sauts = simuler_poisson(lambda_k, 100)  # T suffisamment grand\n",
        "    if len(sauts) >= k:\n",
        "        S_k_values.append(sauts[k-1])  # k-ème saut (index k-1)\n",
        "\n",
        "S_k_values = np.array(S_k_values)\n",
        "\n",
        "print(f"Nombre de simulations valides: {len(S_k_values)}")\n",
        "print(f"Moyenne empirique de S_{k}: {np.mean(S_k_values):.6f}")\n",
        "print(f"Variance empirique de S_{k}: {np.var(S_k_values):.6f}")\n",
        "\n",
        "# Loi théorique: Gamma(k, 1/λ) = Gamma(k, 1)\n",
        "# E[S_k] = k/λ = k\n",
        "# Var(S_k) = k/λ² = k\n",
        "theoretical_mean = k / lambda_k\n",
        "theoretical_var = k / (lambda_k**2)\n",
        "\n",
        "print(f"\nLoi théorique Gamma({k}, 1):")\n",
        "print(f"  E[S_{k}] = {theoretical_mean}")\n",
        "print(f"  Var(S_{k}) = {theoretical_var}")\n",
        "\n",
        "# Visualisation\n",
        "plt.figure(figsize=(15, 6))\n",
        "\n",
        "# Histogramme empirique\n",
        "plt.hist(S_k_values, bins=50, density=True, color='steelblue', alpha=0.7, label=f'S_{k} empirique')\n",
        "\n",
        "# Loi Gamma théorique\n",
        "x = np.linspace(0, max(S_k_values), 100)\n",
        "pdf_gamma = stats.gamma.pdf(x, a=k, scale=1/lambda_k)\n",
        "plt.plot(x, pdf_gamma, 'r-', linewidth=2, label=f'Gamma({k}, 1)')\n",
        "\n",
        "plt.xlabel(f'S_{k} (temps du {k}-ème saut)', fontsize=14)\n",
        "plt.ylabel('Densité', fontsize=14)\n",
        "plt.title(f'Distribution du {k}-ème temps de saut pour λ=1', \n",
        "          fontsize=16, fontweight='bold')\n",
        "plt.legend(fontsize=12)\n",
        "plt.grid(True, alpha=0.3)\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# Test de Kolmogorov-Smirnov\n",
        "ks_stat, ks_pvalue = stats.kstest(S_k_values, 'gamma', args=(k, 0, 1/lambda_k))\n",
        "print(f"\nTest KS: statistique = {ks_stat:.6f}, p-value = {ks_pvalue:.6f}")\n",
        "\n",
        "if ks_pvalue > 0.05:\n",
        "    print("✓ L'hypothèse Gamma est validée empiriquement!")\n",
        "else:\n",
        "    print("⚠ Le test rejette l'hypothèse Gamma, mais cela peut être dû à la discrétisation.")"
      ]
    },
