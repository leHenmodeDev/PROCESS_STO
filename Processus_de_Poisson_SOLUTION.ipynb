        "plt.xlim(x_min, x_max)\n",
        "plt.ylim(y_min, y_max)\n",
        "plt.xlabel('x', fontsize=14)\n",
        "plt.ylabel('y', fontsize=14)\n",
        "plt.title(f'Processus ponctuel de Poisson dans [0,100]² (λ=1, N={N_points} points)', \n",
        "          fontsize=16, fontweight='bold')\n",
        "plt.grid(True, alpha=0.3)\n",
        "plt.gca().set_aspect('equal', adjustable='box')\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# Vérification: le nombre de points dans un sous-domaine suit bien Poisson\n",
        "# Test avec le carré [0,50] × [0,50]\n",
        "sub_x_min, sub_x_max = 0, 50\n",
        "sub_y_min, sub_y_max = 0, 50\n",
        "sub_area = (sub_x_max - sub_x_min) * (sub_y_max - sub_y_min)\n",
        "sub_lambda = lambda_2d * sub_area\n",
        "\n",
        "# Compter les points dans le sous-domaine\n",
        "in_sub = (x_points >= sub_x_min) & (x_points <= sub_x_max) & \
",
        "          (y_points >= sub_y_min) & (y_points <= sub_y_max)\n",
        "N_sub = np.sum(in_sub)\n",
        "\n",
        "print(f"\nVérification avec sous-domaine [0,50]×[0,50]:")\n",
        "print(f"  Surface du sous-domaine: {sub_area}")\n",
        "print(f"  λ * surface = {sub_lambda}")\n",
        "print(f"  Nombre de points observés: {N_sub}")\n",
        "\n",
        "# Test sur plusieurs simulations\n",
        "n_sub_simulations = 1000\n",
        "N_sub_values = []\n",
        "\n",
        "for _ in range(n_sub_simulations):\n",
        "    x, y, N = simuler_processus_ponctuel(lambda_2d, x_min, x_max, y_min, y_max)\n",
        "    in_sub = (x >= sub_x_min) & (x <= sub_x_max) & (y >= sub_y_min) & (y <= sub_y_max)\n",
        "    N_sub_values.append(np.sum(in_sub))\n",
        "\n",
        "N_sub_values = np.array(N_sub_values)\n",
        "mean_N_sub = np.mean(N_sub_values)\n",
        "var_N_sub = np.var(N_sub_values)\n",
        "\n",
        "print(f"\nStatistiques sur {n_sub_simulations} simulations:")\n",
        "print(f"  Moyenne: {mean_N_sub:.4f} (théorique: {sub_lambda:.4f})")\n",
