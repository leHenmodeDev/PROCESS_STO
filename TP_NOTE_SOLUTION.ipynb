      "source": [
        "# Paramètres du problème\n",
        "# Entre 8h et 17h: 9 heures = 9 * 3600 = 32400 secondes\n",
        "# Taux moyen: 3 bus par heure\n",
        "lambda_bus = 3 / 3600  # bus par seconde (3 bus/heure)\n",
        "T = 9 * 3600  # Durée en secondes (8h à 17h)\n",
        "\n",
        "print(f"Paramètre λ: {lambda_bus:.8f} bus/seconde")\n",
        "print(f"Temps total T: {T} secondes ({T/3600} heures)")\n",
        "print(f"Nombre moyen de bus: λ*T = {lambda_bus * T:.2f}")\n",
        "\n",
        "# Fonction de simulation du processus de Poisson\n",
        "def simuler_poisson(lmbda, T):\n",
        "    t = 0\n",
        "    sauts = []\n",
        "    while t < T:\n",
        "        t += np.random.exponential(1/lmbda)\n",
        "        if t < T:\n",
        "            sauts.append(t)\n",
        "    return np.array(sauts)\n",
        "\n",
        "# Simulation d'une journée\n",
        "np.random.seed(42)\n",
        "arrivals = simuler_poisson(lambda_bus, T)\n",
        "\n",
        "print(f"\nNombre de bus simulés: {len(arrivals)}")\n",
        "print(f"Temps d'arrivée (premiers 10): {arrivals[:10] / 3600:.4f} heures")\n",
        "print(f"Temps d'arrivée (derniers 10): {arrivals[-10:] / 3600:.4f} heures")\n",
        "\n",
        "# Représentation graphique\n",
        "plt.figure(figsize=(15, 6))\n",
        "# Convertir en heures pour l'affichage\n",
        "arrivals_hours = arrivals / 3600 + 8  # +8h car on commence à 8h\n",
        "\n",
        "# Tracer les arrivées\n",
        "plt.stem(arrivals_hours, np.ones(len(arrivals_hours)), \n",
        "         linefmt='steelblue-', markerfmt='bo', basefmt=' ')\n",
        "\n",
        "plt.xlabel('Heure', fontsize=14)\n",
        "plt.ylabel('Arrivée de bus', fontsize=14)\n",
        "plt.title('Simulation des arrivées de bus selon un processus de Poisson (λ=3/h)', \n",
        "          fontsize=16, fontweight='bold')\n",
        "plt.xticks(range(8, 18))\n",
        "plt.ylim(0, 2)\n",
        "plt.grid(True, alpha=0.3, axis='x')\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# Histogramme des temps inter-arrivées\n",
        "if len(arrivals) > 1:\n",
