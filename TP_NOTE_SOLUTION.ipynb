      "source": [
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from scipy import stats\n",
        "import pandas as pd\n",
        "import seaborn as sns\n",
        "\n",
        "# Configuration des graphiques\n",
        "plt.style.use('seaborn')\n",
        "np.random.seed(42)  # Pour la reproductibilité"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# Exercice 1: Prédiction d'une série temporelle\n",
        "## 1. Chargement et visualisation des données"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "trusted": true
      },
      "outputs": [],
      "source": [
        "# Charger les données depuis le fichier CSV\n",
        "X = np.loadtxt('donnees (1).csv', delimiter=',')\n",
        "\n",
        "# Afficher les premières valeurs\n",
        "print(f"Nombre de points: {len(X)}")\n",
        "print(f"Moyenne: {np.mean(X):.4f}")\n",
        "print(f"Variance: {np.var(X):.4f}")\n",
        "print(f"Première valeur: {X[0]:.4f}")\n",
        "print(f"Dernière valeur: {X[-1]:.4f}")\n",
        "\n",
        "# Représentation graphique\n",
        "plt.figure(figsize=(15, 6))\n",
        "plt.plot(X, linewidth=1.5, color='steelblue')\n",
        "plt.title('Série temporelle - Données chargées', fontsize=16, fontweight='bold')\n",
        "plt.xlabel('Temps (t)', fontsize=14)\n",
        "plt.ylabel('Valeur X_t', fontsize=14)\n",
        "plt.grid(True, alpha=0.3)\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 2. Modèle AR(1) - Estimation et prédiction\n",
        "Pour un modèle AR(1): X_t = φ * X_{t-1} + ε_t\n",
        "L'estimateur de φ est donné par: φ̂ = Σ(X_t * X_{t-1}) / Σ(X_{t-1}^2)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "trusted": true
      },
      "outputs": [],
      "source": [
        "# Estimation du coefficient φ pour AR(1)\n",
        "n = len(X)\n",
        "\n",
        "# Méthode 1: Estimation par moindres carrés\n",
        "X_prev = X[:-1]\n",
        "X_curr = X[1:]\n",
        "phi_hat_OLS = np.sum(X_prev * X_curr) / np.sum(X_prev**2)\n",
        "\n",
        "# Méthode 2: Estimation par autocorrélation\n",
        "def autocorrelation(x, lag):\n",
        "    n = len(x)\n",
        "    mean = np.mean(x)\n",
        "    var = np.var(x)\n",
        "    return np.mean((x[:n-lag] - mean) * (x[lag:] - mean)) / var\n",
        "\n",
        "rho_1 = autocorrelation(X, 1)\n",
        "phi_hat_ACF = rho_1  # Pour AR(1), φ = ρ(1)\n",
        "\n",
        "# Méthode 3: Estimation par Yule-Walker (plus robuste)\n",
        "phi_hat_YW = np.corrcoef(X_prev, X_curr)[0, 1] * (np.std(X_curr) / np.std(X_prev))\n",
        "\n",
        "print("Estimation de φ pour AR(1):")\n",
        "print(f"  - Moindres carrés: φ̂ = {phi_hat_OLS:.6f}")\n",
        "print(f"  - Autocorrélation: φ̂ = {phi_hat_ACF:.6f}")\n",
        "print(f"  - Yule-Walker: φ̂ = {phi_hat_YW:.6f}")\n",
        "\n",
        "# On utilise la moyenne des estimations\n",
        "phi_hat = np.mean([phi_hat_OLS, phi_hat_ACF, phi_hat_YW])\n",
        "print(f"\nValeur finale estimée: φ̂ = {phi_hat:.6f}")\n",
        "\n",
        "# Prédiction de la valeur suivante\n",
        "X_pred_next = phi_hat * X[-1]\n",
        "print(f"\nPrédiction pour X_{n}: {X_pred_next:.6f}")\n",
        "print(f"Valeur réelle: {X[-1]:.6f}")\n",
        "\n",
        "# Prédiction pour les 50 derniers points\n",
        "X_pred_50 = np.zeros(50)\n",
        "X_pred_50[0] = phi_hat * X[-1]\n",
        "for i in range(1, 50):\n",
        "    X_pred_50[i] = phi_hat * X_pred_50[i-1]\n",
        "\n",
        "# Valeurs réelles des 50 derniers points\n",
        "X_real_50 = X[-50:]"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "trusted": true
      },
      "outputs": [],
      "source": [
        "# Comparaison prédiction vs réalité sur les 50 derniers points\n",
        "plt.figure(figsize=(15, 6))\n",
        "time_indices = range(len(X) - 50, len(X) + 50)\n",
        "\n",
        "# Tracer les valeurs réelles\n",
        "plt.plot(range(len(X)-50, len(X)), X[-50:], 'o-', linewidth=2, markersize=6, \n",
        "         color='steelblue', label='Valeurs réelles')\n",
        "\n",
        "# Tracer les prédictions\n",
        "plt.plot(range(len(X), len(X)+50), X_pred_50, 's--', linewidth=2, markersize=6, \n",
        "         color='coral', label='Prédictions AR(1)')\n",
        "\n",
        "plt.axvline(x=len(X)-0.5, color='red', linestyle='--', alpha=0.5, label='Séparation')\n",
        "plt.title('Comparaison Prédiction AR(1) vs Réalité (50 derniers points + 50 prédictions)', \n",
        "          fontsize=16, fontweight='bold')\n",
        "plt.xlabel('Temps (t)', fontsize=14)\n",
        "plt.ylabel('Valeur X_t', fontsize=14)\n",
        "plt.legend(fontsize=12)\n",
        "plt.grid(True, alpha=0.3)\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# Calcul de l'erreur de prédiction\n",
        "# Pour évaluer, on peut comparer avec les valeurs réelles disponibles\n",
        "# Erreur quadratique moyenne sur les prédictions\n",
        "mse_ar1 = np.mean((X_real_50 - X_pred_50[:len(X_real_50)])**2)\n",
        "rmse_ar1 = np.sqrt(mse_ar1)\n",
        "mae_ar1 = np.mean(np.abs(X_real_50 - X_pred_50[:len(X_real_50)]))\n",
        "\n",
        "print("Erreurs de prédiction AR(1) sur les 50 derniers points:")\n",
        "print(f"  - MSE: {mse_ar1:.6f}")\n",
        "print(f"  - RMSE: {rmse_ar1:.6f}")\n",
        "print(f"  - MAE: {mae_ar1:.6f}")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 3. Modèle MA(1) - Estimation et comparaison\n",
        "Pour un modèle MA(1): X_t = ε_t + θ * ε_{t-1}\n",
        "L'estimation est plus complexe car on n'observe pas directement les ε_t."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "trusted": true
      },
      "outputs": [],
      "source": [
        "# Estimation pour MA(1)\n",
        "# Méthode: On utilise l'autocorrélation\n",
        "# Pour MA(1): ρ(1) = -θ / (1 + θ^2)\n",
        "# On résout: θ^2 * ρ(1) + θ + ρ(1) = 0\n",
        "\n",
        "rho_1 = autocorrelation(X, 1)\n",
        "\n",
        "# Équation quadratique: θ^2 * ρ(1) + θ + ρ(1) = 0\n",
        "# Solutions: θ = [-1 ± sqrt(1 - 4*ρ(1)^2)] / (2*ρ(1))\n",
        "discriminant = 1 - 4 * rho_1**2\n",
        "\n",
        "if discriminant >= 0:\n",
        "    theta1 = (-1 + np.sqrt(discriminant)) / (2 * rho_1)\n",
        "    theta2 = (-1 - np.sqrt(discriminant)) / (2 * rho_1)\n",
        "    theta_hat = theta1  # On choisit la solution inversible (|θ| < 1)\n",
        "    if abs(theta2) < 1 and abs(theta2) < abs(theta1):\n",
        "        theta_hat = theta2\n",
        "    print(f"Estimation de θ pour MA(1): θ̂ = {theta_hat:.6f}")\n",
        "else:\n",
        "    theta_hat = -rho_1 / (1 + rho_1**2)  # Approximation\n",
        "    print(f"Estimation de θ pour MA(1): θ̂ = {theta_hat:.6f} (approximation)")\n",
        "\n",
        "# Simuler les résidus pour MA(1)\n",
        "# ε_t = X_t - θ * ε_{t-1}\n",
        "# On utilise une estimation itérative\n",
        "residuals_ma1 = np.zeros(n)\n",
        "residuals_ma1[0] = X[0]  # ε_0 = X_0\n",
        "\n",
        "# Estimation initiale des résidus\n",
        "for t in range(1, n):\n",
        "    residuals_ma1[t] = X[t] - theta_hat * residuals_ma1[t-1]\n",
        "\n",
        "# Prédiction MA(1)\n",
        "X_pred_ma1_next = theta_hat * residuals_ma1[-1]\n",
        "print(f"Prédiction MA(1) pour X_{n}: {X_pred_ma1_next:.6f}")\n",
        "\n",
        "# Prédiction pour les 50 points suivants\n",
        "X_pred_ma1_50 = np.zeros(50)\n",
        "last_residual = residuals_ma1[-1]\n",
        "for i in range(50):\n",
        "    X_pred_ma1_50[i] = theta_hat * last_residual\n",
        "    last_residual = X_pred_ma1_50[i] - theta_hat * last_residual  # Mise à jour du résidu\n",
        "\n",
        "# Calcul des erreurs MA(1)\n",
        "mse_ma1 = np.mean((X_real_50 - X_pred_ma1_50[:len(X_real_50)])**2)\n",
        "rmse_ma1 = np.sqrt(mse_ma1)\n",
        "mae_ma1 = np.mean(np.abs(X_real_50 - X_pred_ma1_50[:len(X_real_50)]))\n",
        "\n",
        "print("\nErreurs de prédiction MA(1) sur les 50 derniers points:")\n",
        "print(f"  - MSE: {mse_ma1:.6f}")\n",
        "print(f"  - RMSE: {rmse_ma1:.6f}")\n",
        "print(f"  - MAE: {mae_ma1:.6f}")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "trusted": true
      },
      "outputs": [],
      "source": [
        "# Comparaison des deux modèles\n",
        "plt.figure(figsize=(15, 6))\n",
        "\n",
        "# Tracer les valeurs réelles\n",
        "plt.plot(range(len(X)-50, len(X)), X[-50:], 'o-', linewidth=2, markersize=6, \n",
        "         color='steelblue', label='Valeurs réelles')\n",
        "\n",
        "# Tracer les prédictions AR(1)\n",
        "plt.plot(range(len(X), len(X)+50), X_pred_50, 's--', linewidth=2, markersize=6, \n",
        "         color='coral', label='Prédictions AR(1)')\n",
        "\n",
        "# Tracer les prédictions MA(1)\n",
        "plt.plot(range(len(X), len(X)+50), X_pred_ma1_50, '^:', linewidth=2, markersize=6, \n",
        "         color='mediumseagreen', label='Prédictions MA(1)')\n",
        "\n",
        "plt.axvline(x=len(X)-0.5, color='red', linestyle='--', alpha=0.5, label='Séparation')\n",
        "plt.title('Comparaison AR(1) vs MA(1) - Prédictions sur 50 points', \n",
        "          fontsize=16, fontweight='bold')\n",
        "plt.xlabel('Temps (t)', fontsize=14)\n",
        "plt.ylabel('Valeur X_t', fontsize=14)\n",
        "plt.legend(fontsize=12)\n",
        "plt.grid(True, alpha=0.3)\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# Comparaison des erreurs\n",
        "comparison = pd.DataFrame({\n",
        "    'Modèle': ['AR(1)', 'MA(1)'],\n",
        "    'MSE': [mse_ar1, mse_ma1],\n",
        "    'RMSE': [rmse_ar1, rmse_ma1],\n",
        "    'MAE': [mae_ar1, mae_ma1]\n",
        "})\n",
        "\n",
        "print("\nComparaison des erreurs de prédiction:")\n",
        "print(comparison.to_string(index=False))\n",
        "\n",
        "# Analyse des autocorrélations\n",
        "lags = range(10)\n",
        "acf_values = [autocorrelation(X, lag) for lag in lags]\n",
        "\n",
        "plt.figure(figsize=(12, 5))\n",
        "plt.stem(lags, acf_values, use_line_collection=True)\n",
        "plt.axhline(y=0, color='red', linestyle='--')\n",
        "plt.title('Fonction d\'autocorrélation (ACF) de la série', fontsize=16, fontweight='bold')\n",
        "plt.xlabel('Lag', fontsize=14)\n",
        "plt.ylabel('ACF', fontsize=14)\n",
        "plt.grid(True, alpha=0.3)\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# Conclusion\n",
        "print("\n" + "="*60)\n",
        "print("CONCLUSION EXERCICE 1:")\n",
        "print("="*60)\n",
        "if mse_ar1 < mse_ma1:\n",
        "    print("Le modèle AR(1) semble plus adapté (erreur plus faible).")\n",
        "    print(f"AR(1) - φ̂ = {phi_hat:.6f}, MSE = {mse_ar1:.6f}")\n",
        "else:\n",
        "    print("Le modèle MA(1) semble plus adapté (erreur plus faible).")\n",
        "    print(f"MA(1) - θ̂ = {theta_hat:.6f}, MSE = {mse_ma1:.6f}")\n",
        "\n",
        "print("L'ACF montre une décroissance rapide, ce qui suggère")\n",
        "print("que le modèle AR(1) pourrait être approprié pour cette série.")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# Exercice 2: Urnes d'Ehrenfest\n",
        "## 1. Simulation du processus"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "trusted": true
      },
      "outputs": [],
      "source": [
        "# Simulation du modèle d'Ehrenfest\n",
        "N = 10  # Nombre total de boules\n",
        "n_sim = 10000  # Longueur de la trajectoire\n",
        "X0 = 0  # État initial (0 boule dans l'urne A)\n",
        "\n",
        "# Simulation\n",
        "np.random.seed(42)\n",
        "X_ehrenfest = np.zeros(n_sim, dtype=int)\n",
        "X_ehrenfest[0] = X0\n",
        "\n",
        "for t in range(1, n_sim):\n",
        "    # Tirer une boule au hasard parmi les N\n",
        "    ball = np.random.randint(0, N)\n",
        "    \n",
        "    # Si la boule est dans A (X_t > ball), la déplacer vers B\n",
        "    if ball < X_ehrenfest[t-1]:\n",
        "        X_ehrenfest[t] = X_ehrenfest[t-1] - 1\n",
        "    # Sinon (boule dans B), la déplacer vers A\n",
        "    else:\n",
        "        X_ehrenfest[t] = X_ehrenfest[t-1] + 1\n",
        "\n",
        "# Afficher les premiers résultats\n",
        "print(f"Premières valeurs: {X_ehrenfest[:20]}")\n",
        "print(f"Dernières valeurs: {X_ehrenfest[-20:]}")\n",
        "print(f"Valeur finale: {X_ehrenfest[-1]}")\n",
        "\n",
        "# Représentation graphique\n",
        "plt.figure(figsize=(15, 6))\n",
        "plt.plot(X_ehrenfest, linewidth=1, color='steelblue', alpha=0.7)\n",
        "plt.title('Trajectoire du processus d\'Ehrenfest (N=10, n=10000)', \n",
        "          fontsize=16, fontweight='bold')\n",
        "plt.xlabel('Temps t', fontsize=14)\n",
        "plt.ylabel('Nombre de boules dans A', fontsize=14)\n",
        "plt.ylim(-0.5, N+0.5)\n",
        "plt.yticks(range(N+1))\n",
        "plt.grid(True, alpha=0.3)\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 2. Validation empirique de l'ergodicité\n",
        "La loi invariante est la loi binomiale B(N, 0.5)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "trusted": true
      },
      "outputs": [],
      "source": [
        "# Calcul des fréquences empiriques\n",
        "states = range(N + 1)\n",
        "counts = np.zeros(N + 1, dtype=int)\n",
        "\n",
        "for state in X_ehrenfest:\n",
        "    counts[state] += 1\n",
        "\n",
        "# Fréquences empiriques\n",
        "freq_emp = counts / n_sim\n",
        "\n",
        "# Loi binomiale théorique B(N, 0.5)\n",
        "freq_theo = stats.binom.pmf(states, N, 0.5)\n",
        "\n",
        "# Affichage des résultats\n",
        "print("Fréquences empiriques vs théoriques (Binomiale B(10, 0.5)):")\n",
        "print("-" * 60)\n",
        "print(f"{'État':<8} {'Empirique':<15} {'Théorique':<15} {'Différence':<15}")\n",
        "print("-" * 60)\n",
        "for state in states:\n",
        "    print(f'{state:<8} {freq_emp[state]:<15.6f} {freq_theo[state]:<15.6f} {abs(freq_emp[state]-freq_theo[state]):<15.6f}')\n",
        "\n",
        "# Visualisation\n",
        "plt.figure(figsize=(15, 6))\n",
        "bar_width = 0.35\n",
        "indices = np.arange(N + 1)\n",
        "\n",
        "plt.bar(indices - bar_width/2, freq_emp, bar_width, \n",
        "        label='Fréquences empiriques', color='steelblue', alpha=0.8)\n",
        "plt.bar(indices + bar_width/2, freq_theo, bar_width, \n",
        "        label='Loi binomiale B(10, 0.5)', color='coral', alpha=0.8)\n",
        "\n",
        "plt.xlabel('Nombre de boules dans A', fontsize=14)\n",
        "plt.ylabel('Fréquence/Probabilité', fontsize=14)\n",
        "plt.title('Validation de l\'ergodicité - Comparaison empirique vs théorique', \n",
        "          fontsize=16, fontweight='bold')\n",
        "plt.xticks(indices)\n",
        "plt.legend(fontsize=12)\n",
        "plt.grid(True, alpha=0.3, axis='y')\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# Calcul de la distance entre distributions\n",
        "l1_distance = np.sum(np.abs(freq_emp - freq_theo))\n",
        "l2_distance = np.sqrt(np.sum((freq_emp - freq_theo)**2))\n",
        "\n",
        "print(f"\nDistance L1: {l1_distance:.6f}")\n",
        "print(f"Distance L2: {l2_distance:.6f}")\n",
        "\n",
        "if l1_distance < 0.1:\n",
        "    print("\n✓ L'ergodicité est validée empiriquement!")\n",
        "    print("Les fréquences empiriques convergent vers la loi binomiale B(N, 0.5).")\n",
        "else:\n",
        "    print("\n⚠ La convergence est partielle, essayer avec une trajectoire plus longue.")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 3. Convergence en loi quand t → ∞\n",
        "On vérifie si la distribution de X_t converge vers la loi stationnaire."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "trusted": true
      },
      "outputs": [],
      "source": [
        "# Analyse de la convergence au cours du temps\n",
        "# On divise la trajectoire en plusieurs parties\n",
        "n_parts = 5\n",
        "part_size = n_sim // n_parts\n",
        "\n",
        "plt.figure(figsize=(15, 8))\n",
        "\n",
        "for i in range(n_parts):\n",
        "    start = i * part_size\n",
        "    end = (i + 1) * part_size\n",
        "    part = X_ehrenfest[start:end]\n",
        "    \n",
        "    # Calcul des fréquences pour cette partie\n",
        "    part_counts = np.zeros(N + 1, dtype=int)\n",
        "    for state in part:\n",
        "        part_counts[state] += 1\n",
        "    part_freq = part_counts / len(part)\n",
        "    \n",
        "    # Tracé\n",
        "    plt.subplot(n_parts, 1, i + 1)\n",
        "    plt.bar(states, part_freq, color=plt.cm.viridis(i/n_parts), alpha=0.8)\n",
        "    plt.plot(states, freq_theo, 'r--', linewidth=2, label='Théorique')\n",
        "    plt.ylim(0, 0.3)\n",
        "    plt.title(f'Partie {i+1}: t = {start} à {end-1}', fontsize=12)\n",
        "    plt.grid(True, alpha=0.3, axis='y')\n",
        "    if i == n_parts - 1:\n",
        "        plt.legend(fontsize=10)\n",
        "\n",
        "plt.suptitle('Convergence de la distribution vers la loi stationnaire', \n",
        "             fontsize=16, fontweight='bold', y=1.02)\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# Calcul de la convergence de la moyenne\n",
        "cumulative_means = np.cumsum(X_ehrenfest) / np.arange(1, n_sim + 1)\n",
        "theoretical_mean = N * 0.5  # E[Binomiale(N, 0.5)] = N/2\n",
        "\n",
        "plt.figure(figsize=(15, 6))\n",
        "plt.plot(cumulative_means, linewidth=2, color='steelblue', label='Moyenne empirique')\n",
