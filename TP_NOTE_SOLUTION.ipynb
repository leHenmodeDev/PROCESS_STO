        "    plt.hist(inter_arrivals, bins=30, density=True, \n",
        "            color='steelblue', alpha=0.7, label='Empirique')\n",
        "    \n",
        "    # Loi exponentielle théorique\n",
        "    x = np.linspace(0, max(inter_arrivals), 100)\n",
        "    lambda_hour = 3  # 3 bus par heure\n",
        "    pdf_theo = lambda_hour * np.exp(-lambda_hour * x)\n",
        "    plt.plot(x, pdf_theo, 'r-', linewidth=2, label='Exponentielle(λ=3)')\n",
        "    \n",
        "    plt.xlabel('Temps entre arrivées (heures)', fontsize=14)\n",
        "    plt.ylabel('Densité', fontsize=14)\n",
        "    plt.title('Distribution des temps inter-arrivées', \n",
        "              fontsize=16, fontweight='bold')\n",
        "    plt.legend(fontsize=12)\n",
