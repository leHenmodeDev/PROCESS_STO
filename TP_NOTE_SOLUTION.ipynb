        "## 2-3. Simulation de X et Y pour Alice à 14h\n",
        "X: temps depuis le départ du dernier bus\n",
        "Y: temps d'attente avant le prochain bus"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "trusted": true
      },
      "outputs": [],
      "source": [
        "# Simulation sur 1000 jours\n",
        "n_days = 1000\n",
        "alice_time = 14 * 3600  # 14h en secondes (par rapport à 8h: 6*3600)\n",
        "relative_alice_time = alice_time - 8 * 3600  # Temps relatif depuis 8h\n",
        "\n",
        "X_list = []  # Temps depuis le dernier bus\n",
        "Y_list = []  # Temps avant le prochain bus\n",
        "\n",
        "for day in range(n_days):\n",
        "    # Simuler les arrivées pour ce jour\n",
        "    day_arrivals = simuler_poisson(lambda_bus, T)\n",
        "    \n",
        "    if len(day_arrivals) == 0:\n",
        "        # Pas de bus dans la journée\n",
        "        continue\n",
        "    \n",
        "    # Trouver le dernier bus avant 14h\n",
        "    last_bus_before = day_arrivals[day_arrivals <= relative_alice_time]\n",
        "    \n",
        "    if len(last_bus_before) > 0:\n",
        "        X = relative_alice_time - last_bus_before[-1]  # Temps depuis le dernier bus\n",
        "        X_list.append(X)\n",
        "        \n",
        "        # Trouver le premier bus après 14h\n",
        "        next_bus_after = day_arrivals[day_arrivals > relative_alice_time]\n",
        "        if len(next_bus_after) > 0:\n",
        "            Y = next_bus_after[0] - relative_alice_time  # Temps avant le prochain bus\n",
        "            Y_list.append(Y)\n",
        "        else:\n",
        "            # Pas de bus après 14h, Y = temps jusqu'à 17h\n",
        "            Y = T - relative_alice_time\n",
        "            Y_list.append(Y)\n",
        "\n",
        "X_list = np.array(X_list)\n",
        "Y_list = np.array(Y_list)\n",
        "\n",
        "print(f"Nombre de jours avec données valides: {len(X_list)}")\n",
        "print(f"Moyenne de X: {np.mean(X_list)/3600:.4f} heures")\n",
        "print(f"Moyenne de Y: {np.mean(Y_list)/3600:.4f} heures")\n",
        "print(f"Écart-type de X: {np.std(X_list)/3600:.4f} heures")\n",
        "print(f"Écart-type de Y: {np.std(Y_list)/3600:.4f} heures")"
